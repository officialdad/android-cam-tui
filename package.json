{
  "name": "android-cam-tui",
  "version": "0.3.1",
  "description": "Terminal UI for using an Android phone as a Linux webcam, via scrcpy and v4l2loopback",
  "license": "MIT",
  "author": "opariffazman",
  "repository": "github:officialdad/android-cam-tui",
  "homepage": "https://github.com/officialdad/android-cam-tui#readme",
  "bugs": "https://github.com/officialdad/android-cam-tui/issues",
  "keywords": ["scrcpy", "v4l2loopback", "webcam", "android", "tui", "opentui"],
  "type": "module",
  "engines": { "bun": ">=1.3" },
  "bin": { "android-cam-tui": "src/index.tsx" },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "start": "bun run src/index.tsx",
    "demo": "bun run src/ui/demo.tsx",
    "build": "bun build --compile --outfile dist/android-cam-tui src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "react": "^19.2.8"
  }
}
