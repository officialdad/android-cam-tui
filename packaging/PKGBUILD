# Maintainer: opariffazman <opariffazman@gmail.com>
pkgname=android-cam-tui-bin
pkgver=0.3.1
pkgrel=1
pkgdesc="Terminal UI for using an Android phone as a Linux webcam, via scrcpy and v4l2loopback"
arch=('x86_64' 'aarch64')
url="https://github.com/officialdad/android-cam-tui"
license=('MIT')
depends=('scrcpy>=3.0' 'android-tools' 'v4l-utils' 'v4l2loopback-dkms')
optdepends=('ffmpeg: preview window'
            'mpv: preview window'
            'vlc: preview window'
            'android-udev: adb access without root')
provides=("android-cam-tui=$pkgver")
conflicts=('android-cam-tui')
# `bun build --compile` appends the bundled script past the ELF's last section and
# finds it through a trailer. makepkg's default strip discards that, leaving a binary
# that falls through to Bun's own CLI and prints its usage for every flag.
options=('!strip' '!debug')
install="$pkgname.install"
source=("LICENSE-$pkgver::$url/raw/v$pkgver/LICENSE")
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/android-cam-tui-linux-x64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/android-cam-tui-linux-arm64.tar.gz")
sha256sums=('e63d105c68bd498494a00fea7fad35ee03f1797fe35467171672f7270dce963d')
sha256sums_x86_64=('45e0a761f54bd4a51240d33be71271953214e2d2f91ccc9a75a63eb40a53dedf')
sha256sums_aarch64=('3e2f71bd399947a9fdd0611b1b8a28356805d68459dffd3e54ba02458e43c342')

package() {
  install -Dm755 "$srcdir/android-cam-tui" "$pkgdir/usr/bin/android-cam-tui"
  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
